generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  PENDING
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emails Email[]

  @@map("users")
}

model Email {
  id                 String      @id @default(uuid())
  userId             String
  recipient          String
  subject            String
  body               String
  scheduledAt        DateTime
  sentAt             DateTime?
  status             EmailStatus @default(SCHEDULED)
  jobId              String?     @unique
  attempts           Int         @default(0)
  maxAttempts        Int         @default(3)
  errorMessage       String?
  etherealMessageId  String?
  etherealPreviewUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, scheduledAt])
  @@map("emails")
}
