# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MySQL)
DATABASE_URL=mysql://outbox_user:outbox_pass@localhost:3306/outbox_scheduler

# Redis Connection (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=outbox_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Concurrency & Rate Limiting
WORKER_CONCURRENCY=5
EMAIL_RATE_LIMIT_MAX=10
EMAIL_RATE_LIMIT_DURATION_MS=1000

# Ethereal Email Credentials (leave blank to auto-create a test sandbox on startup)
ETHEREAL_USER=
ETHEREAL_PASS=

# Optional: Real Email Delivery (e.g. Gmail)
# If you want emails to actually arrive in your personal inbox instead of Ethereal:
# 1. Enable 2-Step Verification in your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Fill in below and restart backend & worker:
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
